<UserControl x:Class="Nexify.App.Player.TransportBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nexify.App.Localization"
             xmlns:conv="clr-namespace:Nexify.App.Converters"
             xmlns:player="clr-namespace:Nexify.App.Player"
             xmlns:core="clr-namespace:Nexify.Core.Queue;assembly=Nexify.Core"
             AutomationProperties.AutomationId="TransportBar">
    <!-- DataContext: PlayerViewModel. Spec 3.4: 88 px, left now-playing info, centre transport + timeline,
         right volume and the queue button. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="Visible" />
        <conv:BoolToVisibilityConverter x:Key="Collapsed" Invert="True" />
        <conv:RepeatIsOnConverter x:Key="RepeatIsOn" />
        <conv:VolumeGlyphConverter x:Key="VolumeGlyph" />
        <conv:AtLeastOneConverter x:Key="AtLeastOne" />
        <conv:IsPositiveConverter x:Key="IsPositive" />

        <!-- grayscale anti-aliasing for icon glyphs (no coloured ClearType fringes on dark backgrounds) -->
        <Style x:Key="TransportIcon" TargetType="ButtonBase" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="500" />
        </Style>

        <Style x:Key="TimeText" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Caption}">
            <Setter Property="Width" Value="52" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0">
        <Grid Margin="16,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="150" />
                <ColumnDefinition Width="2*" MaxWidth="620" />
                <ColumnDefinition Width="*" MinWidth="176" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================ left: what is playing -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- type tile; the Nexify mark while nothing is playing -->
                <Grid Width="52" Height="52">
                    <Border CornerRadius="12" Background="{DynamicResource Accent.Soft}"
                            Visibility="{Binding HasCurrent, Converter={StaticResource Visible}}">
                        <TextBlock FontFamily="{DynamicResource IconFont}" FontSize="22" Foreground="{DynamicResource Accent.Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextRenderingMode="Grayscale">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE8D6;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                            <Setter Property="Text" Value="&#xE714;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Image Source="pack://application:,,,/Assets/nexify-mark.png" Width="52" Height="52" Opacity="0.9"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasCurrent, Converter={StaticResource Collapsed}}" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <!-- loading LibVLC -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsEngineLoading, Converter={StaticResource Visible}}"
                                AutomationProperties.AutomationId="Transport.Loading">
                        <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource Border.Subtle}" StrokeThickness="2" />
                            <Path Stroke="{DynamicResource Accent.Text}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 7,1 A 6,6 0 0 1 13,7" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" />
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Grid>
                        <TextBlock Style="{StaticResource TextBlock.Caption}" Text="{loc:T player.loading}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource TextBlock.Body}" Foreground="{DynamicResource Text.Muted}"
                               Text="{loc:T player.nothingPlaying}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{x:Static conv:NothingPlayingVisibility.Instance}">
                                <Binding Path="HasCurrent" />
                                <Binding Path="IsEngineLoading" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <StackPanel Visibility="{Binding HasCurrent, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource TextBlock.Subtitle}" FontSize="{DynamicResource Size.Body}"
                                   Text="{Binding CurrentTitle}" ToolTip="{Binding CurrentTitle}"
                                   AutomationProperties.AutomationId="Transport.Title" />
                        <TextBlock Style="{StaticResource TextBlock.Caption}" Margin="0,3,0,0" Text="{Binding CurrentSubtitle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============================================================ centre: transport + timeline -->
            <Grid Grid.Column="1" Margin="12,0" VerticalAlignment="Center" IsEnabled="{Binding IsReady}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ToggleButton Style="{StaticResource TransportIcon}" Width="36" Height="36" FontSize="15" Content="&#xE8B1;"
                                  IsChecked="{Binding Shuffle}" ToolTip="{loc:T player.shuffle}"
                                  AutomationProperties.AutomationId="Transport.Shuffle"
                                  AutomationProperties.Name="{loc:T player.shuffle}" />
                    <Button Style="{StaticResource TransportIcon}" Margin="8,0,0,0" Content="&#xE892;"
                            Command="{Binding PreviousCommand}" ToolTip="{loc:T player.previous}"
                            AutomationProperties.AutomationId="Transport.Previous"
                            AutomationProperties.Name="{loc:T player.previous}" />
                    <Button Margin="10,0" Width="44" Height="44" FontSize="18" Command="{Binding PlayPauseCommand}"
                            TextOptions.TextRenderingMode="Grayscale" AutomationProperties.AutomationId="Transport.PlayPause">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.PlayRound}">
                                <Setter Property="Content" Value="&#xE768;" />
                                <Setter Property="ToolTip" Value="{loc:T player.play}" />
                                <Setter Property="AutomationProperties.Name" Value="{loc:T player.play}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Content" Value="&#xE769;" />
                                        <Setter Property="ToolTip" Value="{loc:T player.pause}" />
                                        <Setter Property="AutomationProperties.Name" Value="{loc:T player.pause}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource TransportIcon}" Margin="0,0,8,0" Content="&#xE893;"
                            Command="{Binding NextCommand}" ToolTip="{loc:T player.next}"
                            AutomationProperties.AutomationId="Transport.Next"
                            AutomationProperties.Name="{loc:T player.next}" />
                    <ToggleButton Width="36" Height="36" FontSize="15" Command="{Binding CycleRepeatCommand}"
                                  IsChecked="{Binding Repeat, Mode=OneWay, Converter={StaticResource RepeatIsOn}}"
                                  AutomationProperties.AutomationId="Transport.Repeat">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource TransportIcon}">
                                <Setter Property="Content" Value="&#xE8EE;" />
                                <Setter Property="ToolTip" Value="{loc:T player.repeatOff}" />
                                <Setter Property="AutomationProperties.Name" Value="{loc:T player.repeatOff}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Repeat}" Value="{x:Static core:RepeatMode.All}">
                                        <Setter Property="ToolTip" Value="{loc:T player.repeatAll}" />
                                        <Setter Property="AutomationProperties.Name" Value="{loc:T player.repeatAll}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Repeat}" Value="{x:Static core:RepeatMode.One}">
                                        <Setter Property="Content" Value="&#xE8ED;" />
                                        <Setter Property="ToolTip" Value="{loc:T player.repeatOne}" />
                                        <Setter Property="AutomationProperties.Name" Value="{loc:T player.repeatOne}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource TimeText}" TextAlignment="Right" Margin="0,0,10,0"
                               Text="{Binding PositionText}" AutomationProperties.AutomationId="Transport.Position" />
                    <player:SeekSlider Grid.Column="1" Style="{StaticResource Slider.Nexify}" Minimum="0"
                                       Maximum="{Binding DurationSeconds, Converter={StaticResource AtLeastOne}}"
                                       Position="{Binding PositionSeconds}"
                                       SeekCommand="{Binding SeekToCommand}"
                                       IsEnabled="{Binding DurationSeconds, Converter={StaticResource IsPositive}}"
                                       AutomationProperties.AutomationId="Transport.Seek" />
                    <TextBlock Grid.Column="2" Style="{StaticResource TimeText}" Margin="10,0,0,0"
                               Text="{Binding DurationText}" AutomationProperties.AutomationId="Transport.Duration" />
                </Grid>
            </Grid>

            <!-- ============================================================ right: volume + queue -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding ToggleMuteCommand}" AutomationProperties.AutomationId="Transport.Mute">
                    <Button.Content>
                        <MultiBinding Converter="{StaticResource VolumeGlyph}">
                            <Binding Path="Volume" />
                            <Binding Path="IsMuted" />
                        </MultiBinding>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TransportIcon}">
                            <Setter Property="ToolTip" Value="{loc:T player.mute}" />
                            <Setter Property="AutomationProperties.Name" Value="{loc:T player.mute}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                    <Setter Property="ToolTip" Value="{loc:T player.unmute}" />
                                    <Setter Property="AutomationProperties.Name" Value="{loc:T player.unmute}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Slider Style="{StaticResource Slider.Nexify}" Width="96" Margin="6,0,0,0" VerticalAlignment="Center"
                        Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                        Focusable="False"
                        Value="{Binding Volume}" ToolTip="{loc:T player.volume}"
                        AutomationProperties.AutomationId="Transport.Volume"
                        AutomationProperties.Name="{loc:T player.volume}" />
                <Border Width="1" Height="24" Margin="14,0,10,0" Background="{DynamicResource Border.Subtle}" />
                <Button x:Name="QueueButton" Style="{StaticResource TransportIcon}" Content="&#xE8FD;"
                        ToolTip="{loc:T player.queue}" Click="OnQueueClick"
                        AutomationProperties.AutomationId="Transport.Queue"
                        AutomationProperties.Name="{loc:T player.queue}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
