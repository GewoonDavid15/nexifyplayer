<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Nexify typography (spec 3.2). Requires a Tokens.*.xaml dictionary merged before this one.
         Archivo and Inter are embedded (Assets/Fonts, OFL-1.1). Both fonts use the typographic family names
         "Archivo" and "Inter"; pick the weight with FontWeight (Regular/Medium/SemiBold/Bold are embedded). -->
    <FontFamily x:Key="Font.Heading">pack://application:,,,/Assets/Fonts/#Archivo</FontFamily>
    <FontFamily x:Key="Font.Body">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
    <FontWeight x:Key="FontWeight.Heading">SemiBold</FontWeight>

    <!-- Icons: Segoe Fluent Icons (Windows 11) with Segoe MDL2 Assets as fallback (Windows 10). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="Size.Display">28</sys:Double>
    <sys:Double x:Key="Size.Title">20</sys:Double>
    <sys:Double x:Key="Size.Subtitle">15</sys:Double>
    <sys:Double x:Key="Size.Body">14</sys:Double>
    <sys:Double x:Key="Size.Caption">12</sys:Double>

    <!-- TextBlock styles. Named TextBlock.* because the Text.* keys are colour brushes. -->
    <Style x:Key="TextBlock.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Body}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="TextBlock.Display" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Heading}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeight.Heading}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Display}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <Style x:Key="TextBlock.Title" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Display}">
        <Setter Property="FontSize" Value="{StaticResource Size.Title}" />
    </Style>

    <Style x:Key="TextBlock.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Base}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource Size.Subtitle}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <Style x:Key="TextBlock.Body" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Base}" />

    <Style x:Key="TextBlock.Caption" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Base}">
        <Setter Property="FontSize" Value="{StaticResource Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    </Style>

    <Style x:Key="TextBlock.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Body}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
