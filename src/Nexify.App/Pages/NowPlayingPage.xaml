<UserControl x:Class="Nexify.App.Pages.NowPlayingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nexify.App.Localization"
             xmlns:conv="clr-namespace:Nexify.App.Converters"
             xmlns:vm="clr-namespace:Nexify.Presentation;assembly=Nexify.Presentation"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             AutomationProperties.AutomationId="Page.NowPlaying">
    <!-- DataContext: PlayerViewModel. Spec 3.1: video surface (or, for audio, a large panel with title and the Nexify mark)
         and the queue on the right (360 px). The VideoView hosts a native window: nothing in WPF can be drawn on top
         of it, so the queue, menus and toasts stay outside its area. It is kept Hidden (not Collapsed) so its window
         exists as soon as a video starts, even when this page is not shown. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="Visible" />
        <conv:BoolToVisibilityConverter x:Key="VisibleOrHidden" UseHidden="True" />
        <conv:BoolToVisibilityConverter x:Key="Collapsed" Invert="True" />

        <ContextMenu x:Key="QueueItemMenu" x:Shared="False" Style="{StaticResource ContextMenu.Nexify}">
            <MenuItem Style="{StaticResource MenuItem.Nexify}" Header="{loc:T queue.playNext}" Click="OnPlayNextClick"
                      AutomationProperties.AutomationId="Queue.PlayNext">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE893;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Style="{StaticResource MenuItem.Nexify}" Header="{loc:T queue.remove}" Click="OnRemoveClick"
                      AutomationProperties.AutomationId="Queue.Remove">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="QueueRow" TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItem.Queue}">
            <Setter Property="Tag" Value="{Binding IsCurrent}" />
            <Setter Property="ContextMenu" Value="{StaticResource QueueItemMenu}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
        </Style>

        <DataTemplate x:Key="QueueRowTemplate" DataType="{x:Type vm:QueueItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="36" Height="36">
                    <Border x:Name="Tile" CornerRadius="10" Background="{DynamicResource Bg.SurfaceHover}" />
                    <TextBlock x:Name="Glyph" FontFamily="{DynamicResource IconFont}" FontSize="15" Text="&#xE8D6;"
                               Foreground="{DynamicResource Text.Muted}" TextOptions.TextRenderingMode="Grayscale"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource TextBlock.Body}" FontWeight="Medium"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                               Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource TextBlock.Caption}" Margin="0,2,0,0" Text="{Binding Folder}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE714;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Accent.Gradient}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent.OnAccent}" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE768;" />
                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource TextBlock.Display}" Text="{loc:T nav.nowPlaying}" Margin="0,0,0,20" />

        <!-- ============================================================ video or audio panel -->
        <Grid Grid.Row="1" Grid.Column="0">
            <!-- audio / nothing playing -->
            <Border Style="{StaticResource Card}" Padding="32" Visibility="{Binding HasVideo, Converter={StaticResource Collapsed}}"
                    AutomationProperties.AutomationId="NowPlaying.AudioPanel">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                    <Image Source="pack://application:,,,/Assets/nexify-mark.png" Width="128" Height="128"
                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center">
                        <Image.Effect>
                            <DropShadowEffect Color="#C6F432" BlurRadius="56" ShadowDepth="0" Opacity="0.35" />
                        </Image.Effect>
                    </Image>
                    <TextBlock Margin="0,28,0,0" Style="{StaticResource TextBlock.Title}" TextAlignment="Center"
                               TextWrapping="Wrap" MaxHeight="56" Text="{Binding CurrentTitle}"
                               Visibility="{Binding HasCurrent, Converter={StaticResource Visible}}"
                               AutomationProperties.AutomationId="NowPlaying.Title" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource TextBlock.Body}" Foreground="{DynamicResource Text.Muted}"
                               TextAlignment="Center" Text="{Binding CurrentSubtitle}"
                               Visibility="{Binding HasCurrent, Converter={StaticResource Visible}}" />
                    <TextBlock Margin="0,28,0,0" Style="{StaticResource TextBlock.Body}" Foreground="{DynamicResource Text.Muted}"
                               TextAlignment="Center" Text="{loc:T player.nothingPlaying}"
                               Visibility="{Binding HasCurrent, Converter={StaticResource Collapsed}}" />
                </StackPanel>
            </Border>

            <!-- video: black rounded frame; the (rectangular) native video window is inset so it stays inside the corners -->
            <Border CornerRadius="16" Background="#000000" Visibility="{Binding HasVideo, Converter={StaticResource VisibleOrHidden}}"
                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                    AutomationProperties.AutomationId="NowPlaying.VideoPanel">
                <vlc:VideoView x:Name="Video" Margin="5" Background="#000000" />
            </Border>
        </Grid>

        <!-- ============================================================ queue -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="8,16,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="8,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource TextBlock.Subtitle}" VerticalAlignment="Center" Text="{loc:T queue.title}" />
                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="8,2" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{DynamicResource Bg.SurfaceHover}"
                            Visibility="{Binding HasItems, ElementName=QueueList, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource TextBlock.Caption}" FontWeight="SemiBold" Text="{Binding QueueItems.Count}" />
                    </Border>
                    <Button Grid.Column="2" Style="{StaticResource Button.Subtle}" MinHeight="32" Padding="12,5"
                            FontSize="{DynamicResource Size.Caption}"
                            Content="{loc:T queue.clear}" Command="{Binding ClearQueueCommand}"
                            IsEnabled="{Binding HasItems, ElementName=QueueList}"
                            AutomationProperties.AutomationId="Queue.Clear" />
                </Grid>

                <ListBox x:Name="QueueList" Grid.Row="1" ItemsSource="{Binding QueueItems}"
                         ItemContainerStyle="{StaticResource QueueRow}" ItemTemplate="{StaticResource QueueRowTemplate}"
                         Background="Transparent" BorderThickness="0" Padding="0" AllowDrop="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.AutomationId="Queue.List"
                         PreviewMouseLeftButtonDown="OnListPreviewMouseDown" PreviewMouseMove="OnListPreviewMouseMove"
                         DragEnter="OnListDragOver" DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop"
                         KeyDown="OnListKeyDown">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Thin}" />
                                </ScrollViewer.Resources>
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                </ListBox>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding HasItems, ElementName=QueueList, Converter={StaticResource Collapsed}}">
                    <TextBlock FontFamily="{DynamicResource IconFont}" FontSize="28" Text="&#xE8FD;" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Text.Muted}" Opacity="0.6" TextOptions.TextRenderingMode="Grayscale" />
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource TextBlock.Body}" Foreground="{DynamicResource Text.Muted}"
                               Text="{loc:T queue.empty}" AutomationProperties.AutomationId="Queue.Empty" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
