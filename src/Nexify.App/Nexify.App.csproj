<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>NexifyPlayer</AssemblyName>
    <RootNamespace>Nexify.App</RootNamespace>
    <StartupObject>Nexify.App.Program</StartupObject>
    <!-- Ruling R2: App.xaml is a Page; Program.Main is the entry point. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>Assets\nexify.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.4" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240627000" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Languages\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Branding and embedded fonts (OFL-1.1); fonts are referenced as pack://application:,,,/Assets/Fonts/#Inter|#Archivo -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\nexify.ico" />
    <Resource Include="Assets\nexify-mark.png" />
    <Content Include="Assets\Fonts\*-OFL.txt" Link="Licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexify.Core\Nexify.Core.csproj" />
    <ProjectReference Include="..\Nexify.Infrastructure\Nexify.Infrastructure.csproj" />
    <ProjectReference Include="..\Nexify.Playback\Nexify.Playback.csproj" />
    <ProjectReference Include="..\Nexify.Presentation\Nexify.Presentation.csproj" />
  </ItemGroup>
</Project>
