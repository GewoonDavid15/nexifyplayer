<Window x:Class="Nexify.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Nexify.App.Localization"
        xmlns:shell="clr-namespace:Nexify.App.Shell"
        xmlns:player="clr-namespace:Nexify.App.Player"
        xmlns:notifications="clr-namespace:Nexify.App.Notifications"
        Title="{loc:T app.title}"
        AutomationProperties.AutomationId="MainWindow"
        Icon="pack://application:,,,/Assets/nexify.ico"
        Width="1280" Height="800" MinWidth="720" MinHeight="480"
        ResizeMode="CanResize"
        Background="{DynamicResource Bg.Base}"
        Foreground="{DynamicResource Text.Body}"
        FontFamily="{DynamicResource Font.Body}"
        FontSize="{DynamicResource Size.Body}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Root gets a margin while maximized to compensate for the WindowChrome overhang. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="88" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- subtle lime glow top-left (spec 3.2; token Bg.Glow: centre 10% / -10%, #0FC6F432 to transparent, none in Light) -->
        <Border Grid.RowSpan="3" Grid.ColumnSpan="2" IsHitTestVisible="False" Background="{DynamicResource Bg.Glow}" />

        <shell:Sidebar x:Name="SidebarPanel" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" />

        <shell:TitleBar x:Name="TitleBarPanel" Grid.Row="0" Grid.Column="1" />

        <!-- Page area: every page is created once and stays in the tree (inactive pages are Hidden), so the
             Now playing video window exists before that page is first shown. Switched with a 150 ms fade + 8 px slide. -->
        <Grid x:Name="PageHost" Grid.Row="1" Grid.Column="1">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PageTranslate" />
            </Grid.RenderTransform>
        </Grid>

        <!-- Toasts bottom right above the transport bar (spec 5) -->
        <notifications:ToastHost x:Name="Toasts" Grid.Row="1" Grid.Column="1" Panel.ZIndex="10"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16" />

        <!-- Transport bar (88 px, spec 3.4) -->
        <player:TransportBar x:Name="Transport" Grid.Row="2" Grid.ColumnSpan="2" />
    </Grid>
</Window>
