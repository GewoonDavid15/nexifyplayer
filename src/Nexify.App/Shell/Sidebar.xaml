<UserControl x:Class="Nexify.App.Shell.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nexify.App.Localization"
             xmlns:conv="clr-namespace:Nexify.App.Converters"
             xmlns:vm="clr-namespace:Nexify.Presentation;assembly=Nexify.Presentation">
    <!-- DataContext: ShellViewModel (inherited from MainWindow). 240 px, or 72 px (icons + tooltips) below 900 px. -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Width" Value="240" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCompact}" Value="True">
                    <Setter Property="Width" Value="72" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <UserControl.Resources>
        <conv:UpperCaseConverter x:Key="UpperCase" />

        <!-- Nav item: the shared ListBoxItem.Nav style; tooltips only in compact mode. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItem.Nav}">
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="ToolTipService.HorizontalOffset" Value="8" />
            <Setter Property="ToolTipService.IsEnabled" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCompact}" Value="True">
                    <Setter Property="ToolTipService.IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Icon follows the item foreground; the active item's icon is in the accent colour. -->
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="24" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCompact}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactCollapsed" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCompact}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- logo header shares the 40 px caption row of the title bar (draggable) -->
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <Image Source="pack://application:,,,/Assets/nexify-mark.png" Width="24" Height="24"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource CompactCollapsed}"
                       Text="{Binding [app.title], Source={x:Static loc:LocProxy.Instance}, Converter={StaticResource UpperCase}}"
                       Margin="10,1,0,0" VerticalAlignment="Center"
                       FontFamily="{DynamicResource Font.Heading}" FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource Text.Primary}" />
        </StackPanel>

        <ListBox Grid.Row="1" Margin="12,20,12,12"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource NavItem}"
                 SelectedValuePath="Tag"
                 SelectedValue="{Binding CurrentPage, Mode=TwoWay}"
                 AutomationProperties.AutomationId="Nav">
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <StackPanel IsItemsHost="True" />
                </ControlTemplate>
            </ListBox.Template>

            <ListBoxItem Tag="{x:Static vm:Page.Home}"
                         AutomationProperties.AutomationId="Nav.Home"
                         AutomationProperties.Name="{loc:T nav.home}"
                         ToolTip="{loc:T nav.home}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;" />
                    <TextBlock Style="{StaticResource NavLabel}" Text="{loc:T nav.home}" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="{x:Static vm:Page.NowPlaying}"
                         AutomationProperties.AutomationId="Nav.NowPlaying"
                         AutomationProperties.Name="{loc:T nav.nowPlaying}"
                         ToolTip="{loc:T nav.nowPlaying}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8D6;" />
                    <TextBlock Style="{StaticResource NavLabel}" Text="{loc:T nav.nowPlaying}" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="{x:Static vm:Page.Settings}"
                         AutomationProperties.AutomationId="Nav.Settings"
                         AutomationProperties.Name="{loc:T nav.settings}"
                         ToolTip="{loc:T nav.settings}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;" />
                    <TextBlock Style="{StaticResource NavLabel}" Text="{loc:T nav.settings}" />
                </StackPanel>
            </ListBoxItem>
        </ListBox>
    </Grid>
</UserControl>
