<UserControl x:Class="Nexify.App.Shell.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nexify.App.Localization"
             xmlns:shell="clr-namespace:Nexify.App.Shell"
             Height="40">
    <UserControl.Resources>
        <!-- Caption buttons: 46 x 40 like Windows, Segoe Fluent chrome glyphs at 10 px. -->
        <Style x:Key="Button.Caption" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Body}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverLayer" Background="{DynamicResource Bg.SurfaceHover}" Opacity="0" />
                            <Border x:Name="PressLayer" Background="{DynamicResource Bg.SurfaceHover}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            </Trigger>
                            <!-- maximize button: hover/press come from the non-client messages (Snap Layouts) -->
                            <Trigger Property="shell:WindowChromeHelper.IsNcHover" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressLayer" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="shell:WindowChromeHelper.IsNcPressed" Value="True">
                                <Setter TargetName="PressLayer" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Button.Caption.Close" TargetType="Button" BasedOn="{StaticResource Button.Caption}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverLayer" Background="#C42B1C" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.8" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="MinimizeButton" Style="{StaticResource Button.Caption}" Content="&#xE921;"
                    ToolTip="{loc:T window.minimize}" AutomationProperties.Name="{loc:T window.minimize}"
                    AutomationProperties.AutomationId="TitleBar.Minimize" Click="OnMinimize" />
            <Button x:Name="MaximizeButtonElement" Style="{StaticResource Button.Caption}" Content="&#xE922;"
                    ToolTip="{loc:T window.maximize}" AutomationProperties.Name="{loc:T window.maximize}"
                    AutomationProperties.AutomationId="TitleBar.Maximize" Click="OnMaximize" />
            <Button x:Name="CloseButton" Style="{StaticResource Button.Caption.Close}" Content="&#xE8BB;"
                    ToolTip="{loc:T common.close}" AutomationProperties.Name="{loc:T common.close}"
                    AutomationProperties.AutomationId="TitleBar.Close" Click="OnClose" />
        </StackPanel>
    </Grid>
</UserControl>
